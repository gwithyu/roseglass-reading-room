{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roseglass-public-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "ReadingRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReadingRoom"]}],
  "vars": {
    "ALLOWED_ORIGINS": "https://replace-with-your-reader-domain.example"
  }
}
